{
  "name": "csf-livebook",
  "version": "1.0.0",
  "private": true,
  "description": "CSF Livebook - Computer Science Fundamentals Interview Master Curriculum Learning Platform",
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "seed:curriculum": "npm run seed:curriculum --workspace=server",
    "seed:demo": "npm run seed:demo --workspace=server"
  },
  "devDependencies": {
    "prettier": "^3.2.5",
    "typescript": "^5.4.5"
  }
}
